model:
  default: "gpt-5.4"
  provider: "custom"
  base_url: "${HERMES_BASE_URL}"
  api_key: "${HERMES_API_KEY}"

terminal:
  backend: "local"
  cwd: "."
  timeout: 180
  lifetime_seconds: 300

memory:
  memory_enabled: true
  user_profile_enabled: true

delegation:
  max_iterations: 35
  default_toolsets: ["terminal", "file"]

cron:
  wrap_response: true

timezone: "Asia/Shanghai"
